{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: Run game",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=game-prototypes",
                    "--package=game-prototypes"
                ],
                "filter": {
                    "name": "game-prototypes",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Unit Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=game-prototypes"
                ],
                "filter": {
                    "name": "game_prototypes",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
